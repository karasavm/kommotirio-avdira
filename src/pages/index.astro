---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HeaderIsland } from '@/components/islands/HeaderIsland';
import { FaqIsland } from '@/components/islands/FaqIsland';
import { HomePageBefore, HomePageAfter, HomePageChrome } from '@/components/HomePage';
import { getContent } from '@/content';
import { Image } from 'astro:assets';
import { siteImages } from '@/lib/site-images';
import { optimizePageImages } from '@/lib/optimize-page-images';

const raw = getContent('el');
const { content, brands, heroPreloadSrc } = await optimizePageImages(raw);
const headerContent = {
  locale: content.locale,
  homePath: content.homePath,
  otherLocalePath: content.otherLocalePath,
  otherLocaleLabel: content.otherLocaleLabel,
  otherLocaleAria: content.otherLocaleAria,
  header: content.header,
  footer: content.footer,
};
---

<BaseLayout content={content} heroPreloadSrc={heroPreloadSrc}>
  <div class="site-shell">
    <HeaderIsland client:idle content={headerContent} />
    <main id="main-content">
      <HomePageBefore content={content} brandImages={brands}>
        <Image
          src={siteImages.hero}
          alt={content.hero.imageAlt}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          priority
          class="hero-lcp-img"
        />
      </HomePageBefore>
      <HomePageAfter content={content}>
        <FaqIsland client:visible content={{ faq: content.faq }} />
      </HomePageAfter>
    </main>
    <HomePageChrome content={content} />
  </div>
</BaseLayout>
